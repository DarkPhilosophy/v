 async function pull() {
+    // custom: discard our applied overlay patches so upstream pulls cleanly;
+    // build() reapplies them afterwards. userplugins are gitignored and persist.
+    await git("checkout", "--", ".");
     const res = await git("pull");
     return res.stdout.includes("Fast-forward");
 }
 
+// custom: our overlay patches live in <checkout>/custom-patches; userplugins persist in src/userplugins.
+async function reapplyCustomOverlay() {
+    const patchesDir = join(VENCORD_SRC_DIR, "custom-patches");
+    for (const patch of ["translate.patch", "update.patch"]) {
+        try {
+            await git("apply", join(patchesDir, patch));
+        } catch {
+            // already applied, or upstream drifted; leave it to save-patch maintenance
+        }
+    }
+}
+
 async function build() {
     const opts = { cwd: VENCORD_SRC_DIR };
 
+    // custom: re-integrate our patches into the freshly pulled upstream before building
+    await reapplyCustomOverlay();
+
     const command = isFlatpak ? "flatpak-spawn" : "node";
     const args = isFlatpak ? ["--host", "node", "scripts/build/build.mjs"] : ["scripts/build/build.mjs"];
 
