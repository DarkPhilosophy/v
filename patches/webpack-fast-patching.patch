+        // Removals keep the regex a valid superset; only patches it does not know require a rebuild.
+        if (patches.some(patch => typeof patch.find === "string" && !prefilteredPatches.has(patch))) {
+            prefilteredPatches.clear();
+            const finds: string[] = [];
+            for (const patch of patches) {
