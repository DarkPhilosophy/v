diff --git a/src/plugins/_core/noTrack.ts b/src/plugins/_core/noTrack.ts
index 5ba03b4..8b02309 100644
--- a/src/plugins/_core/noTrack.ts
+++ b/src/plugins/_core/noTrack.ts
@@ -127,6 +127,12 @@ export default definePlugin({
                 Reflect.deleteProperty(Function.prototype, "d");
                 Reflect.deleteProperty(window, "DiscordSentry");
 
+                window.addEventListener("error", event => {
+                    if (event.error instanceof Error && event.error.message === "Sentry successfully disabled") {
+                        event.preventDefault();
+                    }
+                }, { once: true });
+
                 throw new Error("Sentry successfully disabled");
             }
         });
diff --git a/src/preload.ts b/src/preload.ts
index 5f7adb9..cefcbb7 100644
--- a/src/preload.ts
+++ b/src/preload.ts
@@ -20,6 +20,8 @@ import { debounce } from "@shared/debounce";
 import { IpcEvents } from "@shared/IpcEvents";
 import { contextBridge, webFrame } from "electron/renderer";
 
+import { installDiscordKnownNoiseFilter } from "./discordNoise";
+import { installNoopSentryIpc } from "./sentryIpc";
 import VencordNative, { invoke, sendSync } from "./VencordNative";
 
 contextBridge.exposeInMainWorld("VencordNative", VencordNative);
@@ -29,6 +31,13 @@ if (location.protocol !== "data:") {
     invoke(IpcEvents.INIT_FILE_WATCHERS);
 
     if (IS_DISCORD_DESKTOP) {
+        // Discord's preload initializes the Electron Sentry renderer before
+        // NoTrack can abort the web-app Sentry bundle. If no real preload IPC
+        // bridge exists, install an inert one so Sentry cannot fall back to
+        // unsupported sentry-ipc:// fetches or send reports.
+        installNoopSentryIpc(window as unknown as Record<string, unknown>);
