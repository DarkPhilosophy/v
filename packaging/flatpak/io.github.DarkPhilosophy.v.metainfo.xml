<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.DarkPhilosophy.v</id>
  <name>Vencord Forge</name>
  <summary>Install Vencord into Discord with the plugins you pick</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.DarkPhilosophy">
    <name>DarkPhilosophy</name>
  </developer>
  <url type="homepage">https://darkphilosophy.github.io/v/</url>
  <url type="bugtracker">https://github.com/DarkPhilosophy/v/issues</url>
  <url type="vcs-browser">https://github.com/DarkPhilosophy/v</url>
  <description>
    <p>Vencord Forge builds the Vencord client mod for Discord with exactly the custom plugins and patches you choose, and installs it into the Discord you pick.</p>
    <ul>
      <li>Finds Discord Stable, PTB, Canary and Development, native or Flatpak</li>
      <li>Turn custom plugins and optional patches on or off; the choice is kept across updates</li>
      <li>Optionally installs OpenAsar, a faster replacement for Discord's startup code</li>
      <li>Every change is verified and rolled back on failure, and one click restores stock Discord</li>
    </ul>
    <p>Not affiliated with Discord, Vencord or OpenAsar. Client modifications are against Discord's Terms of Service.</p>
  </description>
  <launchable type="desktop-id">io.github.DarkPhilosophy.v.desktop</launchable>
